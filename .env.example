# COMS.AI environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Stage 1/2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Manila

# --- Map provider (Stage 7) ---
NEXT_PUBLIC_MAP_PROVIDER=
# Required when NEXT_PUBLIC_MAP_PROVIDER=CARTO (CARTO Dark Matter tiles).
NEXT_PUBLIC_MAP_PROVIDER_TOKEN=

# --- Geocoding (Stage 3) ---
GEOCODING_PROVIDER=
GEOCODING_API_KEY=

# --- AI provider (Stage 6/10) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=

# --- Web Push (Stage 12) ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=

# --- Object storage for source screenshots (Stage 5) ---
SUPABASE_STORAGE_BUCKET_SOURCES=source-documents
